<!-- Views/Shared/_Layout.cshtml -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZZ Portfolio Manager</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity.IsAuthenticated)
    {
        <div class="app-container">
            <!-- Sidebar Menu -->
            <aside class="sidebar-menu" id="sidebarMenu">
                <div class="sidebar-header">
                    <div class="sidebar-brand">
                        <i class="fas fa-chart-line"></i>
                        <span class="brand-text">ZZ Portfolio Manager</span>
                    </div>
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>

                <div class="sidebar-content">
                    <!-- MENU Section -->
                    <div class="sidebar-section">
                        <div class="sidebar-section-label">MENU</div>
                        <ul class="sidebar-nav">
                            <li class="sidebar-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                                <a asp-controller="Home" asp-action="Index" class="sidebar-nav-link">
                                    <i class="fas fa-home"></i>
                                    <span class="nav-text">Dashboard</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- CUSTOM Section -->
                    <div class="sidebar-section">
                        <div class="sidebar-section-label">CUSTOM</div>
                        <ul class="sidebar-nav">
                            <li class="sidebar-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Stocks" && ViewContext.RouteData.Values["Action"]?.ToString() == "CreateOrEdit" ? "active" : "")">
                                <a asp-controller="Stocks" asp-action="CreateOrEdit" class="sidebar-nav-link">
                                    <i class="fas fa-plus-circle"></i>
                                    <span class="nav-text">Nueva Operación</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Stocks" && ViewContext.RouteData.Values["Action"]?.ToString() != "CreateOrEdit" ? "active" : "")">
                                <a asp-controller="Stocks" asp-action="Index" class="sidebar-nav-link">
                                    <i class="fas fa-list"></i>
                                    <span class="nav-text">Ver Movimientos</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Historic" ? "active" : "")">
                                <a asp-controller="Historic" asp-action="Index" class="sidebar-nav-link">
                                    <i class="fas fa-history"></i>
                                    <span class="nav-text">Ver Histórico</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Asset" ? "active" : "")">
                                <a asp-controller="Asset" asp-action="Index" class="sidebar-nav-link">
                                    <i class="fas fa-coins"></i>
                                    <span class="nav-text">Gestionar Activos</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- REPORTS Section -->
                    <div class="sidebar-section">
                        <div class="sidebar-section-label">REPORTES</div>
                        <ul class="sidebar-nav">
                            <li class="sidebar-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Portfolio" && ViewContext.RouteData.Values["Action"]?.ToString() == "Report" ? "active" : "")">
                                <a asp-controller="Portfolio" asp-action="Report" class="sidebar-nav-link">
                                    <i class="fas fa-chart-pie"></i>
                                    <span class="nav-text">Reporte Portafolio</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Portfolio" && ViewContext.RouteData.Values["Action"]?.ToString() == "ChartReport" ? "active" : "")">
                                <a asp-controller="Portfolio" asp-action="ChartReport" class="sidebar-nav-link">
                                    <i class="fas fa-chart-line"></i>
                                    <span class="nav-text">Gráficos Portafolio</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MarketData" ? "active" : "")">
                                <a asp-controller="MarketData" asp-action="Index" class="sidebar-nav-link">
                                    <i class="fas fa-chart-area"></i>
                                    <span class="nav-text">Market Data</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "StockQuote" ? "active" : "")">
                                <a asp-controller="StockQuote" asp-action="Index" class="sidebar-nav-link">
                                    <i class="fas fa-search-dollar"></i>
                                    <span class="nav-text">Cotizaciones Yahoo</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- TOOLS Section -->
                    <div class="sidebar-section">
                        <div class="sidebar-section-label">HERRAMIENTAS</div>
                        <ul class="sidebar-nav">
                            <li class="sidebar-nav-item">
                                <a href="#" class="sidebar-nav-link" id="menu-complete-historic">
                                    <i class="fas fa-download"></i>
                                    <span class="nav-text">Completar Histórico</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a href="#" class="sidebar-nav-link" id="menu-update-rates">
                                    <i class="fas fa-exchange-alt"></i>
                                    <span class="nav-text">Actualizar Cotizaciones</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Possession" ? "active" : "")">
                                <a href="#" class="sidebar-nav-link" id="menu-update-possessions">
                                    <i class="fas fa-sync"></i>
                                    <span class="nav-text">Actualizar Posesiones</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </aside>

            <!-- Main Content Area -->
            <div class="main-content">
                <!-- Top Navbar -->
                <nav class="top-navbar">
                    <div class="navbar-left">
                        <button class="menu-toggle-btn" id="menuToggleBtn">
                            <i class="fas fa-bars"></i>
                        </button>
                    </div>

                    <div class="navbar-right">
                        <!-- Full Screen Toggle -->
                        <button class="nav-icon-btn" id="fullscreenBtn" title="Pantalla completa">
                            <i class="fas fa-expand"></i>
                        </button>

                        <!-- Dark Mode Toggle -->
                        <button class="nav-icon-btn" id="darkModeToggle" title="Modo oscuro">
                            <i class="fas fa-moon"></i>
                        </button>

                        <!-- User Menu -->
                        <div class="user-menu-container">
                            <button class="user-menu-btn" id="userMenuBtn">
                                <div class="user-avatar">
                                    <span class="avatar-text">@User.Identity.Name?.Substring(0, 1).ToUpper()</span>
                                </div>
                                <span class="user-name">@User.Identity.Name</span>
                                <i class="fas fa-chevron-down"></i>
                            </button>

                            <div class="user-dropdown" id="userDropdown">
                                <div class="user-dropdown-header">
                                    <div class="dropdown-welcome">Welcome !</div>
                                </div>
                                <div class="user-dropdown-body">
                                    <a href="#" class="dropdown-item">
                                        <i class="fas fa-user"></i>
                                        <span>My Account</span>
                                    </a>                                    
                                    <div class="dropdown-divider"></div>
                                    <form method="post" asp-controller="Account" asp-action="Logout">
                                        <button type="submit" class="dropdown-item logout-item">
                                            <i class="fas fa-sign-out-alt"></i>
                                            <span>Logout</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </nav>

                <!-- Alert container for notifications -->
                <div id="alert-container" class="alert-container">
                    <!-- Las alertas se mostrarán aquí dinámicamente -->
                </div>

                <!-- Page Content -->
                <main class="page-content">
                    @RenderBody()
                </main>

                <!-- Footer -->
                <footer class="app-footer">
                    <div class="footer-content">
                        <div class="footer-left">
                            <small class="text-muted">
                                © 2024 ZZ Portfolio Manager - Sistema de gestión de activos financieros
                            </small>
                        </div>
                        <div class="footer-right">
                            <small class="text-muted">
                                <i class="fas fa-clock"></i> Última actualización: <span id="last-update">--</span>
                            </small>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Not authenticated view -->
        <main class="container mt-3">
            @RenderBody()
        </main>
    }

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Layout Scripts -->
    <script>
        $(document).ready(function() {
            // Sidebar toggle
            $('#sidebarToggle, #menuToggleBtn').click(function() {
                $('.sidebar-menu').toggleClass('collapsed');
                $('.main-content').toggleClass('expanded');
            });

            // User menu dropdown
            $('#userMenuBtn').click(function(e) {
                e.stopPropagation();
                $('#userDropdown').toggleClass('show');
            });

            $(document).click(function() {
                $('#userDropdown').removeClass('show');
            });

            $('#userDropdown').click(function(e) {
                e.stopPropagation();
            });

            // Fullscreen toggle
            $('#fullscreenBtn').click(function() {
                if (!document.fullscreenElement) {
                    document.documentElement.requestFullscreen();
                    $(this).find('i').removeClass('fa-expand').addClass('fa-compress');
                } else {
                    document.exitFullscreen();
                    $(this).find('i').removeClass('fa-compress').addClass('fa-expand');
                }
            });

            // Dark mode toggle
            $('#darkModeToggle').click(function() {
                $('body').toggleClass('dark-mode');
                const icon = $(this).find('i');
                icon.toggleClass('fa-moon fa-sun');
            });

            // Menu actions
            $('#menu-complete-historic').click(function(e) {
                e.preventDefault();
                completeHistoric();
            });

            $('#menu-update-rates').click(function(e) {
                e.preventDefault();
                updateExchangeRates();
            });

            $('#menu-update-possessions').click(function(e) {
                e.preventDefault();
                updatePossessions();
            });

            // Update timestamp
            updateLastUpdateTime();
            setInterval(updateLastUpdateTime, 60000);
        });

        function completeHistoric() {
            showAlert('info', 'Completando datos históricos...', 'fas fa-spinner fa-spin');

            $.post('@Url.Action("CompleteAllAssets", "Historic")')
                .done(function(response) {
                    if (response.message) {
                        showAlert('success', response.message, 'fas fa-check');
                    } else if (response.error) {
                        showAlert('danger', response.error, 'fas fa-exclamation-triangle');
                    }
                })
                .fail(function() {
                    showAlert('danger', 'Error al completar histórico', 'fas fa-exclamation-triangle');
                });
        }

        function updateExchangeRates() {
            showAlert('info', 'Actualizando cotizaciones de monedas...', 'fas fa-spinner fa-spin');

            $.post('@Url.Action("UpdateExchangeRates", "Historic")')
                .done(function(response) {
                    if (response.message) {
                        let message = response.message;
                        if (response.details) {
                            message += ` (${response.details.totalProcessed} procesadas)`;
                        }
                        showAlert('success', message, 'fas fa-check');
                    } else if (response.error) {
                        showAlert('danger', response.error, 'fas fa-exclamation-triangle');
                    }
                })
                .fail(function() {
                    showAlert('danger', 'Error al actualizar cotizaciones de monedas', 'fas fa-exclamation-triangle');
                });
        }

        function updatePossessions() {
            showAlert('info', 'Actualizando posesiones...', 'fas fa-spinner fa-spin');

            $.post('@Url.Action("UpdateAll", "Possession")')
                .done(function(response) {
                    if (response.message) {
                        showAlert('success', response.message, 'fas fa-check');
                    } else if (response.error) {
                        showAlert('danger', response.error, 'fas fa-exclamation-triangle');
                    }
                })
                .fail(function() {
                    showAlert('danger', 'Error al actualizar posesiones', 'fas fa-exclamation-triangle');
                });
        }

        function showAlert(type, message, icon = '') {
            const alertId = 'alert-' + Date.now();
            const iconHtml = icon ? `<i class="${icon} me-2"></i>` : '';

            const alertHtml = `
                <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${iconHtml}${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;

            $('#alert-container').append(alertHtml);

            // Auto-dismiss después de 5 segundos (excepto para loading)
            if (type !== 'info' || !icon.includes('fa-spin')) {
                setTimeout(function() {
                    $(`#${alertId}`).alert('close');
                }, 5000);
            }
        }

        function updateLastUpdateTime() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('es-ES');
            $('#last-update').text(timeString);
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>