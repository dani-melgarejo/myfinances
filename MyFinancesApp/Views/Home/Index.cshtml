@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-main-content">
    <!-- Page Header -->
    <div class="page-header-container mb-4">
        <div class="page-header-left">
            <h1 class="page-title">Dashboard</h1>
            <nav aria-label="breadcrumb" class="page-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">ZZ Portfolio Manager</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Welcome Section -->
    <div class="welcome-section mb-4">
        <div class="welcome-card">
            <div class="welcome-content">
                <h2 class="welcome-title">Bienvenido a ZZ Portfolio Manager</h2>
                <p class="welcome-text">Sistema de gestión de activos financieros. Utiliza el menú lateral para navegar entre las diferentes secciones.</p>
            </div>
            <div class="welcome-icon">
                <i class="fas fa-chart-line"></i>
            </div>
        </div>
    </div>

    <!-- Info Cards -->
    <div class="row g-3">
        <div class="col-md-6">
            <div class="info-card">
                <div class="info-card-header">
                    <i class="fas fa-info-circle"></i>
                    <h5>Acceso Rápido</h5>
                </div>
                <div class="info-card-body">
                    <p>Utiliza el menú lateral para acceder a:</p>
                    <ul class="info-list">
                        <li><i class="fas fa-plus-circle text-primary"></i> Nueva Operación</li>
                        <li><i class="fas fa-list text-info"></i> Ver Listado de Movimientos</li>
                        <li><i class="fas fa-history text-success"></i> Ver Histórico</li>
                        <li><i class="fas fa-coins text-warning"></i> Gestionar Activos</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="info-card">
                <div class="info-card-header">
                    <i class="fas fa-chart-bar"></i>
                    <h5>Reportes y Análisis</h5>
                </div>
                <div class="info-card-body">
                    <p>Accede a herramientas avanzadas:</p>
                    <ul class="info-list">
                        <li><i class="fas fa-chart-pie text-secondary"></i> Reporte de Portafolio</li>
                        <li><i class="fas fa-chart-line text-primary"></i> Gráficos de Tendencias</li>
                        <li><i class="fas fa-chart-area text-info"></i> Market Data</li>
                        <li><i class="fas fa-search text-success"></i> Cotizaciones Yahoo</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
}
