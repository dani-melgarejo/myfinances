@using MyFinances.Logic.Models
@model PortfolioReportRequestViewModel

@{
    ViewData["Title"] = "Evolución del Portafolio";
}

<div class="dashboard-main-content">
    <!-- Page Header -->
    <div class="page-header-container mb-4">
        <div class="page-header-content">
            <div class="page-header-left">
                <h1 class="page-title">Evolución del Portafolio</h1>
                <nav aria-label="breadcrumb" class="page-breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">ZZ Portfolio Manager</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Report", "Portfolio")">Reportes</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Gráficos</li>
                    </ol>
                </nav>
            </div>
            <div class="page-actions">
                <a asp-controller="Portfolio" asp-action="Report" class="btn btn-outline-secondary">
                    <i class="fas fa-table me-1"></i> Ver Tabla
                </a>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="filter-card mb-4">
        <div class="filter-card-header">
            <div class="filter-title">
                <i class="fas fa-filter me-2"></i> Filtros de Fecha
            </div>
            <button type="button" id="btn-export" class="btn btn-sm btn-outline-primary" disabled>
                <i class="fas fa-download me-1"></i> Exportar PNG
            </button>
        </div>
        <div class="filter-card-body">
            <form id="report-form">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="fechaInicio" class="form-label">Fecha Inicio</label>
                        <input type="date" class="form-control" id="fechaInicio"
                               value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label for="fechaFin" class="form-label">Fecha Fin</label>
                        <input type="date" class="form-control" id="fechaFin"
                               value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">&nbsp;</label>
                        <div>
                            <button type="button" id="btn-generate-report" class="btn btn-primary w-100">
                                <i class="fas fa-chart-line me-1"></i> Generar Gráfico
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Loading -->
    <div id="loading" class="text-center d-none py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 text-muted">Generando gráfico...</p>
    </div>

    <!-- Resumen de métricas -->
    <div id="metrics-summary" class="row g-3 mb-4 d-none">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="metric-card">
                <div class="metric-card-body">
                    <div class="metric-header">
                        <div class="metric-title">RENDIMIENTO PORTAFOLIO</div>
                        <div class="metric-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                    </div>
                    <div class="metric-value" id="portfolio-performance">0.00%</div>
                    <div class="metric-badge metric-badge-neutral">
                        <span class="badge-text">Rendimiento total</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="metric-card">
                <div class="metric-card-body">
                    <div class="metric-header">
                        <div class="metric-title">RENDIMIENTO S&P 500</div>
                        <div class="metric-icon">
                            <i class="fas fa-chart-area"></i>
                        </div>
                    </div>
                    <div class="metric-value" id="sp500-performance">0.00%</div>
                    <div class="metric-badge metric-badge-neutral">
                        <span class="badge-text">Benchmark</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="metric-card">
                <div class="metric-card-body">
                    <div class="metric-header">
                        <div class="metric-title">GANANCIA/PÉRDIDA</div>
                        <div class="metric-icon">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                    </div>
                    <div class="metric-value" id="total-gain-loss">$0.00</div>
                    <div class="metric-badge" id="gain-loss-badge">
                        <span class="badge-text">En el período</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="metric-card">
                <div class="metric-card-body">
                    <div class="metric-header">
                        <div class="metric-title">INVERSIÓN NETA</div>
                        <div class="metric-icon">
                            <i class="fas fa-wallet"></i>
                        </div>
                    </div>
                    <div class="metric-value" id="net-investment">$0.00</div>
                    <div class="metric-badge metric-badge-neutral">
                        <span class="badge-text">Capital invertido</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfico de Evolución -->
    <div id="charts-container" class="d-none">
        <div class="data-card">
            <div class="data-card-header">
                <div class="data-card-title">
                    <i class="fas fa-chart-line me-2"></i> Evolución Temporal de Rendimientos: Portafolio vs S&P 500
                </div>
            </div>
            <div class="data-card-body p-4">
                <canvas id="portfolio-evolution-chart" style="max-height: 500px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Mensaje de error -->
    <div id="error-message" class="alert alert-danger d-none" role="alert">
        <!-- El mensaje de error se mostrará aquí -->
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            let chart = null;

            $('#btn-generate-report').click(function() {
                generateReport();
            });

            $('#btn-export').click(function() {
                exportChart();
            });

            function generateReport() {
                const fechaInicio = $('#fechaInicio').val();
                const fechaFin = $('#fechaFin').val();

                if (!fechaInicio || !fechaFin) {
                    alert('Por favor seleccione ambas fechas');
                    return;
                }

                if (new Date(fechaInicio) > new Date(fechaFin)) {
                    alert('La fecha de inicio no puede ser mayor a la fecha fin');
                    return;
                }

                $('#loading').removeClass('d-none');
                $('#charts-container').addClass('d-none');
                $('#metrics-summary').addClass('d-none');
                $('#error-message').addClass('d-none');
                $('#btn-export').prop('disabled', true);

                const requestData = {
                    fechaInicio: fechaInicio,
                    fechaFin: fechaFin
                };

                $.ajax({
                    url: '@Url.Action("GetDailyReportData", "Portfolio")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function(response) {
                        $('#loading').addClass('d-none');

                        if (response.success && response.data && response.data.length > 0) {
                            displayChart(response.data);
                            calculateAndDisplayMetrics(response.data);
                            $('#btn-export').prop('disabled', false);
                        } else {
                            showError('No hay datos para el período seleccionado');
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#loading').addClass('d-none');
                        showError('Error al generar el reporte: ' + (xhr.responseText || error));
                    }
                });
            }

            function calculateAndDisplayMetrics(dailyData) {
                if (dailyData.length === 0) return;

                // Calcular rendimientos acumulados
                let portfolioAccum = 0;
                let sp500Accum = 0;
                let totalGainLoss = 0;
                let netInvestment = 0;

                dailyData.forEach(function(item) {
                    const porcentaje = item.porcentajeGananciaPerdida || item.PorcentajeGananciaPerdida || 0;
                    const sp500 = item.sp500Rendimiento || item.SP500Rendimiento || 0;
                    const ganancia = item.gananciaPerdidaUsd || item.GananciaPerdidaUsd || 0;
                    const inversion = item.inversionNeta || item.InversionNeta || 0;

                    portfolioAccum = porcentaje; // Usar el último valor acumulado
                    sp500Accum = sp500;
                    totalGainLoss = ganancia;
                    netInvestment = inversion;
                });

                // Actualizar métricas
                $('#portfolio-performance').text(formatNumber(portfolioAccum, 2) + '%')
                    .removeClass('text-success text-danger')
                    .addClass(portfolioAccum >= 0 ? 'text-success' : 'text-danger');

                $('.metric-card').eq(0).find('.metric-badge')
                    .removeClass('metric-badge-success metric-badge-danger metric-badge-neutral')
                    .addClass(portfolioAccum >= 0 ? 'metric-badge-success' : 'metric-badge-danger');

                $('#sp500-performance').text(formatNumber(sp500Accum, 2) + '%')
                    .removeClass('text-success text-danger')
                    .addClass(sp500Accum >= 0 ? 'text-success' : 'text-danger');

                $('.metric-card').eq(1).find('.metric-badge')
                    .removeClass('metric-badge-success metric-badge-danger metric-badge-neutral')
                    .addClass(sp500Accum >= 0 ? 'metric-badge-success' : 'metric-badge-danger');

                $('#total-gain-loss').text('$' + formatNumber(totalGainLoss, 2))
                    .removeClass('text-success text-danger')
                    .addClass(totalGainLoss >= 0 ? 'text-success' : 'text-danger');

                $('#gain-loss-badge')
                    .removeClass('metric-badge-success metric-badge-danger metric-badge-neutral')
                    .addClass(totalGainLoss >= 0 ? 'metric-badge-success' : 'metric-badge-danger');

                $('#net-investment').text('$' + formatNumber(netInvestment, 2));

                $('#metrics-summary').removeClass('d-none');
            }

            function displayChart(dailyData) {
                const ctx = document.getElementById('portfolio-evolution-chart').getContext('2d');
                
                if (chart) {
                    chart.destroy();
                }

                // Preparar datos
                const labels = [];
                const portfolioReturns = [];
                const sp500Returns = [];

                dailyData.forEach(function(item) {
                    let fecha = item.fecha || item.Fecha;
                    if (!fecha) return;

                    const date = new Date(fecha);
                    if (isNaN(date.getTime())) return;

                    const dayLabel = date.toLocaleDateString('es-ES', { 
                        day: '2-digit', 
                        month: '2-digit',
                        year: '2-digit'
                    });

                    const porcentaje = item.porcentajeGananciaPerdida || item.PorcentajeGananciaPerdida || 0;
                    const sp500 = item.sp500Rendimiento || item.SP500Rendimiento || 0;

                    labels.push(dayLabel);
                    portfolioReturns.push(porcentaje);
                    sp500Returns.push(sp500);
                });

                chart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Mi Portafolio (%)',
                                data: portfolioReturns,
                                borderColor: 'rgb(102, 126, 234)',
                                backgroundColor: 'rgba(102, 126, 234, 0.1)',
                                borderWidth: 3,
                                fill: true,
                                tension: 0.4,
                                pointBackgroundColor: 'rgb(102, 126, 234)',
                                pointBorderColor: '#fff',
                                pointBorderWidth: 2,
                                pointRadius: 3,
                                pointHoverRadius: 6
                            },
                            {
                                label: 'S&P 500 (%)',
                                data: sp500Returns,
                                borderColor: 'rgb(255, 159, 64)',
                                backgroundColor: 'rgba(255, 159, 64, 0.1)',
                                borderWidth: 3,
                                fill: true,
                                tension: 0.4,
                                pointBackgroundColor: 'rgb(255, 159, 64)',
                                pointBorderColor: '#fff',
                                pointBorderWidth: 2,
                                pointRadius: 3,
                                pointHoverRadius: 6
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            title: {
                                display: false
                            },
                            legend: {
                                display: true,
                                position: 'top',
                                labels: {
                                    font: {
                                        size: 14,
                                        weight: 'bold'
                                    },
                                    padding: 15,
                                    usePointStyle: true,
                                    pointStyle: 'circle'
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                titleFont: {
                                    size: 14,
                                    weight: 'bold'
                                },
                                bodyFont: {
                                    size: 13
                                },
                                padding: 12,
                                cornerRadius: 8,
                                displayColors: true,
                                callbacks: {
                                    label: function(context) {
                                        return context.dataset.label + ': ' + formatNumber(context.raw, 2) + '%';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return formatNumber(value, 2) + '%';
                                    },
                                    font: {
                                        size: 12
                                    }
                                },
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.05)',
                                    drawBorder: false
                                }
                            },
                            x: {
                                grid: {
                                    display: false,
                                    drawBorder: false
                                },
                                ticks: {
                                    maxRotation: 45,
                                    minRotation: 45,
                                    font: {
                                        size: 11
                                    },
                                    maxTicksLimit: 20
                                }
                            }
                        },
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        }
                    }
                });

                $('#charts-container').removeClass('d-none');
            }

            function showError(message) {
                $('#error-message').text(message).removeClass('d-none');
            }

            function formatNumber(num, decimals = 2) {
                if (num == null) return '-';
                return new Intl.NumberFormat('en-US', {
                    minimumFractionDigits: decimals,
                    maximumFractionDigits: decimals
                }).format(num);
            }

            function exportChart() {
                if (!chart) {
                    alert('No hay gráfico para exportar');
                    return;
                }

                const link = document.createElement('a');
                link.download = `evolucion_portafolio_${$('#fechaInicio').val()}_${$('#fechaFin').val()}.png`;
                link.href = chart.toBase64Image();
                link.click();
            }

            // Generar reporte inicial
            generateReport();
        });
    </script>
}

@section Styles {
    <style>
        #portfolio-evolution-chart {
            height: 500px !important;
        }

        .data-card-body {
            min-height: 550px;
        }
    </style>
}
