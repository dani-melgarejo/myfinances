@using MyFinances.Logic.Models
<!-- Views/Portfolio/Report.cshtml -->
@model PortfolioReportRequestViewModel

@{
    ViewData["Title"] = "Reporte de Portafolio";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Reporte de Portafolio</h2>
            <div>
                <a asp-controller="Portfolio" asp-action="ChartReport" class="btn btn-outline-primary">
                    <i class="fas fa-chart-line"></i> Ver Gráficos
                </a>
            </div>
        </div>

        <!-- Filtros -->
        <div class="card mb-4">
            <div class="card-body">
                <form id="report-form">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label for="fechaInicio" class="form-label">Fecha Inicio</label>
                                <input type="date" class="form-control" id="fechaInicio"
                                       value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label for="fechaFin" class="form-label">Fecha Fin</label>
                                <input type="date" class="form-control" id="fechaFin"
                                       value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label for="currency-select" class="form-label">Moneda de Reporte</label>
                                <select id="currency-select" class="form-control select2">
                                    <option value="">USD (Por defecto)</option>
                                </select>
                                <small class="form-text text-muted">Seleccione la moneda para mostrar los valores</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label class="form-label">&nbsp;</label>
                                <div>
                                    <button type="button" id="btn-generate-report" class="btn btn-primary">
                                        <i class="fas fa-chart-bar"></i> Generar Reporte
                                    </button>
                                    <button type="button" id="btn-export" class="btn btn-success" disabled>
                                        <i class="fas fa-file-excel"></i> Exportar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Loading -->
        <div id="loading" class="text-center d-none">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Generando reporte...</p>
        </div>

        <!-- Tabla de resultados -->
        <div id="report-container" class="d-none">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Resultados del Reporte</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="portfolio-table">
                            <thead class="table-dark">
                                <tr>
                                    <th>Tipo</th>
                                    <th>Ticker</th>
                                    <th>Tenencia Inicial <span id="currency-header-1">($)</span></th>
                                    <th>Tenencia Final <span id="currency-header-2">($)</span></th>
                                    <th>Ganancia/Pérdida <span id="currency-header-3">($)</span></th>
                                    <th>Compras <span id="currency-header-4">($)</span></th>
                                    <th>Ventas <span id="currency-header-5">($)</span></th>
                                    <th>Inversión Neta <span id="currency-header-6">($)</span></th>
                                    <th>% Ganancia/Pérdida</th>
                                    <th>SP500</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Los datos se cargarán dinámicamente -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mensaje de error -->
        <div id="error-message" class="alert alert-danger d-none" role="alert">
            <!-- El mensaje de error se mostrará aquí -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let reportData = [];
            let currentCurrency = { code: 'USD', symbol: '$' };

            // Initialize currency select
            $('#currency-select').select2({
                placeholder: 'USD (Por defecto)',
                allowClear: true,
                ajax: {
                    url: '@Url.Action("GetCurrencies", "Portfolio")',
                    dataType: 'json',
                    delay: 250,
                    processResults: function (data) {
                        return {
                            results: data
                        };
                    },
                    cache: true
                }
            });

            // Handle currency change
            $('#currency-select').on('change', function() {
                const selectedData = $(this).select2('data')[0];
                
                if (selectedData && selectedData.symbol) {
                    currentCurrency = {
                        code: selectedData.code,
                        symbol: selectedData.symbol
                    };
                } else {
                    currentCurrency = { code: 'USD', symbol: '$' };
                }
                
                updateCurrencyHeaders();
            });

            $('#btn-generate-report').click(function() {
                generateReport();
            });

            $('#btn-export').click(function() {
                exportToExcel();
            });

            function updateCurrencyHeaders() {
                const symbol = `(${currentCurrency.symbol})`;
                $('#currency-header-1, #currency-header-2, #currency-header-3, #currency-header-4, #currency-header-5, #currency-header-6')
                    .text(symbol);
            }

            function generateReport() {
                const fechaInicio = $('#fechaInicio').val();
                const fechaFin = $('#fechaFin').val();
                const selectedCurrency = $('#currency-select').val();

                if (!fechaInicio || !fechaFin) {
                    alert('Por favor seleccione ambas fechas');
                    return;
                }

                if (new Date(fechaInicio) > new Date(fechaFin)) {
                    alert('La fecha de inicio no puede ser mayor a la fecha fin');
                    return;
                }

                // Mostrar loading
                $('#loading').removeClass('d-none');
                $('#report-container').addClass('d-none');
                $('#error-message').addClass('d-none');
                $('#btn-export').prop('disabled', true);

                const requestData = {
                    fechaInicio: fechaInicio,
                    fechaFin: fechaFin,
                    targetCurrencyId: selectedCurrency || null
                };

                $.ajax({
                    url: '@Url.Action("GetReportData", "Portfolio")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function(response) {
                        $('#loading').addClass('d-none');

                        if (response.success) {
                            reportData = response.data;
                            
                            // Update current currency from response
                            if (response.currency) {
                                currentCurrency = response.currency;
                                updateCurrencyHeaders();
                            }
                            
                            displayReport(response.data);
                            $('#btn-export').prop('disabled', false);
                        } else {
                            showError(response.error || 'Error desconocido');
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#loading').addClass('d-none');
                        showError('Error al generar el reporte: ' + error);
                    }
                });
            }

            function displayReport(data) {
                const tbody = $('#portfolio-table tbody');
                tbody.empty();

                data.forEach(function(item) {
                    const row = `
                        <tr class="${item.tipoReporte === 'TOTAL PORTAFOLIO' ? 'table-warning fw-bold' : ''}">
                            <td>${item.tipoReporte}</td>
                            <td>${item.ticker}</td>
                            <td class="text-end">${currentCurrency.symbol}${formatNumber(item.tenenciaInicial)}</td>
                            <td class="text-end">${currentCurrency.symbol}${formatNumber(item.tenenciaFinal)}</td>
                            <td class="text-end ${item.gananciaPerdidaUsd >= 0 ? 'text-success' : 'text-danger'}">
                                ${currentCurrency.symbol}${formatNumber(item.gananciaPerdidaUsd)}
                            </td>
                            <td class="text-end">${currentCurrency.symbol}${formatNumber(item.compras)}</td>
                            <td class="text-end">${currentCurrency.symbol}${formatNumber(item.ventas)}</td>
                            <td class="text-end">${currentCurrency.symbol}${formatNumber(item.inversionNeta)}</td>
                            <td class="text-end ${item.porcentajeGananciaPerdida >= 0 ? 'text-success' : 'text-danger'}">
                                ${formatNumber(item.porcentajeGananciaPerdida)}%
                            </td>
                            <td class="text-end ${item.sP500Rendimiento >= 0 ? 'text-success' : 'text-danger'}">
                                ${formatNumber(item.sP500Rendimiento)}%
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });

                $('#report-container').removeClass('d-none');
            }

            function showError(message) {
                $('#error-message').text(message).removeClass('d-none');
            }

            function formatNumber(num) {
                return new Intl.NumberFormat('en-US', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(num);
            }

            function exportToExcel() {
                if (reportData.length === 0) {
                    alert('No hay datos para exportar');
                    return;
                }

                // Crear CSV con la moneda seleccionada
                let csv = `Tipo,Ticker,Valor Inicial (${currentCurrency.code}),Valor Final (${currentCurrency.code}),Ganancia/Pérdida (${currentCurrency.code}),Total Invertido (${currentCurrency.code}),Total Retirado (${currentCurrency.code}),Inversión Neta (${currentCurrency.code}),% Ganancia/Pérdida,SP500\n`;

                reportData.forEach(function(item) {
                    csv += `"${item.tipoReporte}","${item.ticker}",${item.tenenciaInicial},${item.tenenciaFinal},${item.gananciaPerdidaUsd},${item.compras},${item.ventas},${item.inversionNeta},${item.porcentajeGananciaPerdida},${item.sP500Rendimiento}\n`;
                });

                // Descargar archivo
                const blob = new Blob([csv], { type: 'text/csv' });
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.setAttribute('hidden', '');
                a.setAttribute('href', url);
                a.setAttribute('download', `reporte_portafolio_${currentCurrency.code}_${$('#fechaInicio').val()}_${$('#fechaFin').val()}.csv`);
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            }

            // Initialize currency headers
            updateCurrencyHeaders();
            
            // Generar reporte inicial
            generateReport();
        });
    </script>
}

@section Styles {
    <style>
        .table th {
            white-space: nowrap;
        }

        .table td {
            white-space: nowrap;
        }

        .table-warning {
            border-top: 2px solid #ffc107;
        }

        #portfolio-table {
            font-size: 0.9rem;
        }

        .text-success {
            color: #28a745 !important;
        }

        .text-danger {
            color: #dc3545 !important;
        }
    </style>
}