@using MyFinances.Logic.Models
@model MarketDataFilterViewModel
@{
    ViewData["Title"] = "Datos de Mercado";
}

<div class="dashboard-main-content">
    <!-- Page Header -->
    <div class="page-header-container mb-4">
        <div class="page-header-left">
            <h1 class="page-title">Datos de Mercado</h1>
            <nav aria-label="breadcrumb" class="page-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">ZZ Portfolio Manager</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Market Data</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Filtros -->
    <div class="filter-card mb-4">
        <div class="filter-card-header">
            <div class="filter-title">
                <i class="fas fa-filter me-2"></i> Filtros de Búsqueda
            </div>
            <button type="button" id="btn-clear-filters" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-times me-1"></i> Limpiar
            </button>
        </div>
        <div class="filter-card-body">
            <form id="filter-form">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="assetSelect" class="form-label">Asset</label>
                        <select class="form-control select2" id="assetSelect" name="AssetId">
                            <option value="">Todos los assets...</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="tickerFilter" class="form-label">Ticker</label>
                        <input type="text" class="form-control" id="tickerFilter" name="Ticker" 
                               placeholder="Ej: AAPL" />
                    </div>
                    <div class="col-md-2">
                        <label for="fechaDesde" class="form-label">Fecha Desde</label>
                        <input type="date" class="form-control" id="fechaDesde" name="FechaDesde" 
                               value="@Model.FechaDesde?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-2">
                        <label for="fechaHasta" class="form-label">Fecha Hasta</label>
                        <input type="date" class="form-control" id="fechaHasta" name="FechaHasta" 
                               value="@Model.FechaHasta?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-2">
                        <label for="pageSize" class="form-label">Registros</label>
                        <select class="form-control" id="pageSize" name="PageSize">
                            <option value="10">10</option>
                            <option value="25" selected>25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">&nbsp;</label>
                        <div>
                            <button type="button" id="btn-search" class="btn btn-primary w-100">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Loading -->
    <div id="loading" class="text-center d-none py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 text-muted">Cargando datos...</p>
    </div>

    <!-- Tabla de resultados -->
    <div id="data-container">
        <div class="data-card">
            <div class="data-card-header">
                <div class="data-card-title">
                    <i class="fas fa-chart-line me-2"></i> Cotizaciones de Mercado
                    <span id="total-records" class="badge bg-secondary ms-2">0</span>
                </div>
                <div class="data-card-actions">
                    <button id="btn-add" class="btn btn-success btn-sm me-2">
                        <i class="fas fa-plus me-1"></i> Nueva Cotización
                    </button>
                    <button id="btn-export" class="btn btn-outline-primary btn-sm" disabled>
                        <i class="fas fa-download me-1"></i> Exportar
                    </button>
                </div>
            </div>
            <div class="data-card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="market-data-table">
                        <thead>
                            <tr>
                                <th data-sort="ticker" class="sortable">
                                    Ticker <i class="fas fa-sort ms-1"></i>
                                </th>
                                <th data-sort="date" class="sortable">
                                    Fecha <i class="fas fa-sort ms-1"></i>
                                </th>
                                <th data-sort="closeprice" class="text-end sortable">
                                    Precio Cierre <i class="fas fa-sort ms-1"></i>
                                </th>
                                <th class="text-center action-column">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Los datos se cargarán dinámicamente aquí -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="data-card-footer">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div id="pagination-info" class="pagination-info">
                            <!-- Información de paginación -->
                        </div>
                    </div>
                    <div class="col-md-6">
                        <nav aria-label="Paginación">
                            <ul class="pagination pagination-sm justify-content-end mb-0" id="pagination">
                                <!-- Paginación se generará dinámicamente -->
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mensaje de error -->
    <div id="error-message" class="alert alert-danger d-none" role="alert">
        <!-- El mensaje de error se mostrará aquí -->
    </div>
</div>

<!-- Modal de Detalles -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-info-circle me-2"></i> Detalles de Cotización
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modal-body-content">
                <!-- Se cargará dinámicamente -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let currentData = [];
            let currentFilter = {
                page: 1,
                pageSize: 25,
                sortBy: 'date',
                sortDirection: 'desc'
            };

            // Inicializar Select2 para assets
            $('#assetSelect').select2({
                placeholder: 'Buscar asset...',
                allowClear: true,
                minimumInputLength: 0,
                ajax: {
                    url: '@Url.Action("Search", "Asset")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            q: params.term || ''
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data
                        };
                    },
                    cache: true
                }
            });

            // Event handlers
            $('#btn-search').click(function() {
                currentFilter.page = 1;
                loadData();
            });

            $('#btn-clear-filters').click(function() {
                $('#filter-form')[0].reset();
                $('#assetSelect').val(null).trigger('change');
                currentFilter.page = 1;
                loadData();
            });

            $('#btn-add').click(function() {
                window.location.href = '@Url.Action("Create", "MarketData")';
            });

            $('#btn-export').click(function() {
                exportToExcel();
            });

            $('#pageSize').change(function() {
                currentFilter.pageSize = parseInt($(this).val());
                currentFilter.page = 1;
                loadData();
            });

            // Sorting
            $('#market-data-table th[data-sort]').click(function() {
                const sortBy = $(this).data('sort');
                
                if (currentFilter.sortBy === sortBy) {
                    currentFilter.sortDirection = currentFilter.sortDirection === 'asc' ? 'desc' : 'asc';
                } else {
                    currentFilter.sortBy = sortBy;
                    currentFilter.sortDirection = 'asc';
                }
                
                updateSortIcons();
                currentFilter.page = 1;
                loadData();
            });

            function updateSortIcons() {
                $('#market-data-table th[data-sort] i').removeClass('fa-sort-up fa-sort-down').addClass('fa-sort');
                
                const currentHeader = $(`#market-data-table th[data-sort="${currentFilter.sortBy}"] i`);
                currentHeader.removeClass('fa-sort');
                
                if (currentFilter.sortDirection === 'asc') {
                    currentHeader.addClass('fa-sort-up');
                } else {
                    currentHeader.addClass('fa-sort-down');
                }
            }

            function loadData() {
                const filterData = {
                    assetId: $('#assetSelect').val() || null,
                    ticker: $('#tickerFilter').val() || null,
                    fechaDesde: $('#fechaDesde').val() || null,
                    fechaHasta: $('#fechaHasta').val() || null,
                    page: currentFilter.page,
                    pageSize: currentFilter.pageSize,
                    sortBy: currentFilter.sortBy,
                    sortDirection: currentFilter.sortDirection
                };

                $('#loading').removeClass('d-none');
                $('#data-container').addClass('d-none');
                $('#error-message').addClass('d-none');

                $.ajax({
                    url: '@Url.Action("GetData", "MarketData")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(filterData),
                    success: function(response) {
                        $('#loading').addClass('d-none');
                        
                        if (response.success) {
                            currentData = response.data.data;
                            displayData(response.data);
                            $('#btn-export').prop('disabled', currentData.length === 0);
                        } else {
                            showError(response.error || 'Error desconocido');
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#loading').addClass('d-none');
                        showError('Error al cargar los datos: ' + error);
                    }
                });
            }

            function displayData(result) {
                const tbody = $('#market-data-table tbody');
                tbody.empty();

                if (result.data.length === 0) {
                    tbody.append(`
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                                <p class="mb-0">No se encontraron cotizaciones con los filtros aplicados</p>
                            </td>
                        </tr>
                    `);
                } else {
                    result.data.forEach(function(item) {
                        const row = `
                            <tr>
                                <td><strong>${item.ticker}</strong></td>
                                <td>${formatDate(item.date)}</td>
                                <td class="text-end"><span class="text-primary fw-bold">$${formatNumber(item.close)}</span></td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button class="btn btn-outline-primary" onclick="editMarketData(${item.id})" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-outline-info" onclick="viewDetails(${item.id})" title="Ver detalles">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" onclick="deleteMarketData(${item.id})" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        `;
                        tbody.append(row);
                    });
                }

                updatePagination(result);
                updateSortIcons();
                $('#data-container').removeClass('d-none');
            }

            function updatePagination(result) {
                $('#total-records').text(result.total);
                
                const start = (result.page - 1) * result.pageSize + 1;
                const end = Math.min(result.page * result.pageSize, result.total);
                $('#pagination-info').text(`Mostrando ${start} a ${end} de ${result.total} registros`);

                const pagination = $('#pagination');
                pagination.empty();

                if (result.totalPages <= 1) return;

                // Botón anterior
                if (result.page > 1) {
                    pagination.append(`
                        <li class="page-item">
                            <a class="page-link" href="#" onclick="goToPage(${result.page - 1}); return false;">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    `);
                }

                // Números de página
                const startPage = Math.max(1, result.page - 2);
                const endPage = Math.min(result.totalPages, result.page + 2);

                if (startPage > 1) {
                    pagination.append(`<li class="page-item"><a class="page-link" href="#" onclick="goToPage(1); return false;">1</a></li>`);
                    if (startPage > 2) {
                        pagination.append(`<li class="page-item disabled"><span class="page-link">...</span></li>`);
                    }
                }

                for (let i = startPage; i <= endPage; i++) {
                    const active = i === result.page ? 'active' : '';
                    pagination.append(`
                        <li class="page-item ${active}">
                            <a class="page-link" href="#" onclick="goToPage(${i}); return false;">${i}</a>
                        </li>
                    `);
                }

                if (endPage < result.totalPages) {
                    if (endPage < result.totalPages - 1) {
                        pagination.append(`<li class="page-item disabled"><span class="page-link">...</span></li>`);
                    }
                    pagination.append(`<li class="page-item"><a class="page-link" href="#" onclick="goToPage(${result.totalPages}); return false;">${result.totalPages}</a></li>`);
                }

                // Botón siguiente
                if (result.page < result.totalPages) {
                    pagination.append(`
                        <li class="page-item">
                            <a class="page-link" href="#" onclick="goToPage(${result.page + 1}); return false;">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    `);
                }
            }

            // Funciones globales
            window.goToPage = function(page) {
                currentFilter.page = page;
                loadData();
            };

            window.editMarketData = function(id) {
                window.location.href = '@Url.Action("Edit", "MarketData")/' + id;
            };

            window.viewDetails = function(id) {
                $.get('@Url.Action("GetDetails", "MarketData")', { id: id })
                    .done(function(response) {
                        if (response.success) {
                            showDetailsModal(response.data);
                        } else {
                            alert('Error: ' + response.error);
                        }
                    })
                    .fail(function() {
                        alert('Error al obtener los detalles');
                    });
            };

            window.deleteMarketData = function(id) {
                if (confirm('¿Está seguro de que desea eliminar esta cotización?')) {
                    $.post('@Url.Action("Delete", "MarketData")', { id: id })
                        .done(function(response) {
                            if (response.success) {
                                showAlert('success', response.message);
                                loadData();
                            } else {
                                showAlert('danger', response.error);
                            }
                        })
                        .fail(function() {
                            showAlert('danger', 'Error al eliminar la cotización');
                        });
                }
            };

            function showDetailsModal(data) {
                const modalContent = `
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Ticker:</dt>
                        <dd class="col-sm-8"><strong>${data.ticker}</strong></dd>
                        
                        <dt class="col-sm-4">Fecha:</dt>
                        <dd class="col-sm-8">${formatDate(data.date)}</dd>
                        
                        <dt class="col-sm-4">Precio Cierre:</dt>
                        <dd class="col-sm-8"><span class="text-primary fw-bold">$${formatNumber(data.close)}</span></dd>
                    </dl>
                `;
                
                $('#modal-body-content').html(modalContent);
                
                const modal = new bootstrap.Modal(document.getElementById('detailsModal'));
                modal.show();
            }

            function showError(message) {
                $('#error-message').text(message).removeClass('d-none');
                $('#data-container').addClass('d-none');
            }

            function showAlert(type, message) {
                const alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${type === 'success' ? '<i class="fas fa-check-circle me-2"></i>' : '<i class="fas fa-exclamation-circle me-2"></i>'} ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                
                $('.dashboard-main-content').prepend(alertHtml);
                
                setTimeout(function() {
                    $('.alert').alert('close');
                }, 3000);
            }

            function formatNumber(num) {
                if (num == null) return '-';
                return new Intl.NumberFormat('en-US', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 4
                }).format(num);
            }

            function formatDate(dateString) {
                if (!dateString) return '-';
                const date = new Date(dateString);
                return date.toLocaleDateString('es-ES', { 
                    year: 'numeric', 
                    month: '2-digit', 
                    day: '2-digit' 
                });
            }

            function exportToExcel() {
                if (currentData.length === 0) {
                    alert('No hay datos para exportar');
                    return;
                }

                let csv = 'Ticker,Fecha,Precio Cierre\n';
                
                currentData.forEach(function(item) {
                    csv += `"${item.ticker}","${formatDate(item.date)}","${item.close}"\n`;
                });

                const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                const url = window.URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.setAttribute('href', url);
                link.setAttribute('download', `market_data_${new Date().toISOString().split('T')[0]}.csv`);
                link.style.visibility = 'hidden';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }

            // Cargar datos inicial
            loadData();
        });
    </script>
}

@section Styles {
    <style>
        /* Sortable columns */
        .sortable {
            cursor: pointer;
            user-select: none;
            transition: background-color 0.2s ease;
        }
        
        .sortable:hover {
            background-color: rgba(102, 126, 234, 0.1);
        }
        
        .sortable i {
            font-size: 0.75em;
            opacity: 0.5;
            transition: opacity 0.2s ease;
        }
        
        .sortable:hover i {
            opacity: 1;
        }
        
        /* Action column */
        .action-column {
            width: 180px;
        }
        
        /* Empty state */
        .table tbody td i.fa-inbox {
            color: #d0d7de;
        }
    </style>
}
